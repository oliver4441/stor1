{
  "env": {
    "browser": true,
    "es2020": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-empty": "warn",
    "no-useless-escape": "warn",
    "no-dupe-keys": "warn",
    "no-const-assign": "warn",
    "no-case-declarations": "warn",
    "no-inner-declarations": "warn"
  }
}
